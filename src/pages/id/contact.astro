---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import BrandIcon from '@/components/BrandIcon.astro';
import { profileId } from '@/data/profile';
import { socials } from '@/data/socials';

const schema = { '@context': 'https://schema.org', '@type': 'ContactPage', name: `Kontak ${profileId.name}`, url: `${profileId.domain}/id/contact/`, inLanguage: 'id', mainEntity: { '@type': 'Person', name: profileId.name, url: profileId.domain, email: profileId.email, sameAs: [socials.linkedin, socials.github, socials.instagram, socials.orcid] } };
---

<BaseLayout locale="id" title="Kontak | Muhammad Habib Rafi" description="Hubungi Muhammad Habib Rafi, Full Stack Web Developer di Pekanbaru, melalui email, LinkedIn, GitHub, atau Instagram." image="/og/id-contact.png" structuredData={schema}>
  <section class="page-section" aria-labelledby="contact-title"><div class="site-container contact-grid">
    <div class="contact-intro"><p class="eyebrow">Kontak</p><h1 id="contact-title">Mari membangun sesuatu yang berguna.</h1><p>Untuk peluang pengembangan, diskusi proyek, atau kolaborasi profesional, hubungi saya melalui profil berikut.</p></div>
    <div class="contact-options">
      <a class="contact-card" href={socials.linkedin} target="_blank" rel="noopener noreferrer"><div class="contact-card-icon brand-linkedin"><BrandIcon name="linkedin" size={21} /></div><div><span>Jaringan profesional</span><strong>LinkedIn</strong></div><Icon name="arrow_outward" size={19} /></a>
      <a class="contact-card" href={socials.github} target="_blank" rel="noopener noreferrer"><div class="contact-card-icon brand-github"><BrandIcon name="github" size={21} /></div><div><span>Kode dan proyek</span><strong>GitHub</strong></div><Icon name="arrow_outward" size={19} /></a>
      <a class="contact-card" href={socials.instagram} target="_blank" rel="noopener noreferrer"><div class="contact-card-icon brand-instagram"><BrandIcon name="instagram" size={21} /></div><div><span>Aktivitas dan profil profesional</span><strong>Instagram</strong></div><Icon name="arrow_outward" size={19} /></a>
      {profileId.email && <a class="contact-card" href={`mailto:${profileId.email}`}><div class="contact-card-icon"><Icon name="mail" size={22} /></div><div><span>Email</span><strong>{profileId.email}</strong></div><Icon name="arrow_outward" size={19} /></a>}
      <div class="contact-card"><div class="contact-card-icon"><Icon name="location_on" size={22} filled /></div><div><span>Lokasi</span><strong>{profileId.location}</strong></div></div>
    </div>
  </div></section>
</BaseLayout>
