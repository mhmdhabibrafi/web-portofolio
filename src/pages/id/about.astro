---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import { profileId } from '@/data/profile';
import { educationId } from '@/data/education';

const workAreas = [
  ['Pengembangan Aplikasi Web', 'Membangun antarmuka dan alur aplikasi web yang lengkap berdasarkan kebutuhan nyata.'],
  ['Pengembangan Backend', 'Mengimplementasikan perilaku server, aturan bisnis, dan layanan aplikasi.'],
  ['Pengembangan REST API', 'Merancang dan menghubungkan endpoint API yang mendukung kebutuhan frontend dan integrasi.'],
  ['Desain dan Integrasi Basis Data', 'Memodelkan data relasional dan menghubungkannya secara aman dengan alur aplikasi.'],
  ['Integrasi Frontend', 'Mengubah kapabilitas backend menjadi antarmuka yang responsif dan mudah digunakan.'],
  ['Deployment dan Konfigurasi Server', 'Menyiapkan aplikasi untuk delivery statis, container, maupun berbasis server.'],
  ['Pemeliharaan Sistem', 'Menjaga sistem operasional tetap andal ketika kebutuhan dan lingkungan berubah.'],
  ['Dokumentasi Teknis', 'Menulis panduan implementasi dan operasional yang jelas untuk pekerjaan yang mudah dipelihara.'],
];
const schema = { '@context': 'https://schema.org', '@type': 'AboutPage', name: `Tentang ${profileId.name}`, url: `${profileId.domain}/id/about/`, inLanguage: 'id', mainEntity: { '@type': 'Person', name: profileId.name, jobTitle: profileId.title, url: profileId.domain } };
---

<BaseLayout locale="id" title="Tentang | Muhammad Habib Rafi" description="Mengenal Muhammad Habib Rafi, Full Stack Web Developer dan mahasiswa Sistem Informasi di Pekanbaru, Indonesia." image="/og/id-about.png" type="profile" structuredData={schema}>
  <header class="page-hero"><div class="site-container page-hero-inner"><p class="eyebrow">Tentang</p><h1>Membangun perangkat lunak di seluruh lapisan aplikasi.</h1><p>Saya Muhammad Habib Rafi, Full Stack Web Developer, mahasiswa Sistem Informasi, dan penulis teknologi di Pekanbaru.</p></div></header>
  <section class="page-section" aria-labelledby="about-story-title"><div class="site-container content-grid">
    <div><p class="eyebrow">Profil</p><h2 id="about-story-title">Pekerjaan perangkat lunak praktis dengan pemikiran sistem.</h2></div>
    <div class="content-copy">
      <p>Saya membangun aplikasi web, layanan backend, REST API, integrasi basis data, dan sistem operasional. Pekerjaan saya menghubungkan implementasi teknis dengan alur yang benar-benar dibutuhkan oleh produk atau organisasi.</p>
      <p>Bekerja pada frontend dan backend membantu saya memahami bagaimana keputusan antarmuka, aturan bisnis, autentikasi, model data, integrasi, dan deployment saling memengaruhi. Saya berusaha menjaga lapisan tersebut tetap mudah dipahami dan dipelihara.</p>
      <p>Studi Sistem Informasi memberikan pandangan lebih luas tentang hubungan perangkat lunak, manusia, data, dan proses operasional. Penulisan teknis melengkapi pekerjaan tersebut dengan mengubah pengetahuan implementasi menjadi dokumentasi yang dapat digunakan orang lain.</p>
      <p class="hero-location"><Icon name="location_on" size={18} filled /> {profileId.location}</p>
      <div class="button-row"><a class="button button-primary" href="/id/projects/">Lihat studi kasus proyek <Icon name="arrow_forward" size={18} /></a><a class="button button-secondary" href="/id/experience/">Lihat pengalaman</a></div>
    </div>
  </div></section>
  <section class="page-section section-surface" aria-labelledby="work-title"><div class="site-container">
    <SectionHeading eyebrow="Yang saya kerjakan" title="Pengembangan dari antarmuka hingga infrastruktur." description="Ruang lingkup praktis yang mencakup lapisan aplikasi dan pekerjaan pendukung untuk menghasilkan sistem web yang mudah dipelihara." />
    <div class="what-i-do-grid">{workAreas.map(([title, description]) => <article class="what-i-do-card"><h3 id={title === 'Pengembangan Aplikasi Web' ? 'work-title' : undefined}>{title}</h3><p>{description}</p></article>)}</div>
  </div></section>
  <section class="page-section" aria-labelledby="about-education-title"><div class="site-container">
    <SectionHeading eyebrow="Pendidikan" title="Sistem Informasi" description="Studi formal yang berjalan bersama pengalaman pengembangan langsung." />
    <article class="education-card"><div class="education-icon"><Icon name="school" size={24} filled /></div><div><h3 id="about-education-title">{educationId.institution}</h3><p>{educationId.program} · {educationId.location}</p></div><span class="education-status">{educationId.status}</span></article>
  </div></section>
</BaseLayout>
