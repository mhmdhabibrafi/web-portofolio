---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import { profile } from '@/data/profile';
import { education } from '@/data/education';
import { withBase } from '@/utils/paths';

const workAreas = [
  ['Web Application Development', 'Build complete web interfaces and application workflows around concrete requirements.'],
  ['Backend Development', 'Implement server-side behaviour, business rules, and application services.'],
  ['REST API Development', 'Design and connect API endpoints that support frontend and integration needs.'],
  ['Database Design and Integration', 'Model relational data and connect it safely to application workflows.'],
  ['Frontend Integration', 'Turn backend capabilities into usable, responsive interfaces.'],
  ['Deployment and Server Configuration', 'Prepare applications for static, containerized, and server-based delivery.'],
  ['System Maintenance', 'Keep operational systems dependable as requirements and environments change.'],
  ['Technical Documentation', 'Write clear implementation and operational guidance for maintainable work.'],
];

const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: `About ${profile.name}`,
  url: `${profile.domain}/about/`,
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    jobTitle: profile.title,
    url: profile.domain,
  },
};
---

<BaseLayout title="About | Muhammad Habib Rafi" description="Learn about Muhammad Habib Rafi, a Full Stack Web Developer and Information Systems student in Pekanbaru, Indonesia." image="/og/about.png" type="profile" structuredData={aboutSchema}>
  <header class="page-hero">
    <div class="site-container page-hero-inner">
      <p class="eyebrow">About</p>
      <h1>Building software across the full application stack.</h1>
      <p>I am Muhammad Habib Rafi, a Full Stack Web Developer, Information Systems student, and technical writer based in Pekanbaru.</p>
    </div>
  </header>

  <section class="page-section" aria-labelledby="about-story-title">
    <div class="site-container content-grid">
      <div><p class="eyebrow">Profile</p><h2 id="about-story-title">Practical software work, grounded in systems thinking.</h2></div>
      <div class="content-copy">
        <p>I build web applications, backend services, REST APIs, database integrations, and operational systems. My work connects technical implementation to the workflow a product or organization actually needs to run.</p>
        <p>Working across frontend and backend helps me see how interface decisions, business rules, authentication, data models, integrations, and deployment affect one another. I aim to keep those layers understandable and maintainable.</p>
        <p>My Information Systems studies provide a broader view of how software, people, data, and operational processes fit together. Technical writing complements that work by turning implementation knowledge into documentation others can use.</p>
        <p class="hero-location"><Icon name="location_on" size={18} filled /> {profile.location}</p>
        <div class="button-row"><a class="button button-primary" href={withBase('/projects/')}>View project case studies <Icon name="arrow_forward" size={18} /></a><a class="button button-secondary" href={withBase('/experience/')}>View experience</a></div>
      </div>
    </div>
  </section>

  <section class="page-section section-surface" aria-labelledby="work-title">
    <div class="site-container">
      <SectionHeading eyebrow="What I do" title="Development from interface to infrastructure." description="A practical scope covering the application layers and supporting work needed to deliver maintainable web systems." />
      <div class="what-i-do-grid">
        {workAreas.map(([title, description]) => <article class="what-i-do-card"><h3 id={title === 'Web Application Development' ? 'work-title' : undefined}>{title}</h3><p>{description}</p></article>)}
      </div>
    </div>
  </section>

  <section class="page-section" aria-labelledby="about-education-title">
    <div class="site-container">
      <SectionHeading eyebrow="Education" title="Information Systems" description="Formal study alongside applied development experience." />
      <article class="education-card">
        <div class="education-icon"><Icon name="school" size={24} filled /></div>
        <div><h3 id="about-education-title">{education.institution}</h3><p>{education.program} · {education.location}</p></div>
        <span class="education-status">{education.status}</span>
      </article>
    </div>
  </section>
</BaseLayout>
