---
interface Props {
  eyebrow?: string;
  title: string;
  titleId?: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, titleId, description, align = 'left' } = Astro.props;
---

<div class:list={['section-heading', `section-heading-${align}`]}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={titleId}>{title}</h2>
  {description && <p>{description}</p>}
</div>
