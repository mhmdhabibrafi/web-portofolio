---
import { Image } from 'astro:assets';
import completionImage from '@/assets/1784901021952.jpg';
import englishImage from '@/assets/1784901010611.jpg';
import capstoneImage from '@/assets/1784901021573.jpg';
import achievementImage from '@/assets/1784901019871.jpg';
import Icon from './Icon.astro';
import type { Locale } from '@/i18n/config';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;

const credentials = locale === 'en'
  ? [
      { title: 'Full-Stack Web Developer', meta: 'Certificate of Completion · Coding Camp 2026', image: completionImage, alt: 'Coding Camp 2026 Full-Stack Web Developer certificate of completion for Muhammad Habib Rafi' },
      { title: 'Best Capstone Team', meta: 'Top 15 Capstone Project Teams · Coding Camp 2026', image: capstoneImage, alt: 'Best Capstone Team certificate for Muhammad Habib Rafi at Coding Camp 2026' },
      { title: 'Student Learning Achievement', meta: 'Full-Stack Web Developer learning transcript', image: achievementImage, alt: 'Coding Camp 2026 student learning achievement transcript for Muhammad Habib Rafi' },
      { title: 'English for Business Communication', meta: 'Short course · Overall score 76%', image: englishImage, alt: 'English for Business Communication certificate for Muhammad Habib Rafi' },
    ]
  : [
      { title: 'Full-Stack Web Developer', meta: 'Sertifikat Kelulusan · Coding Camp 2026', image: completionImage, alt: 'Sertifikat kelulusan Full-Stack Web Developer Coding Camp 2026 atas nama Muhammad Habib Rafi' },
      { title: 'Best Capstone Team', meta: '15 Tim Proyek Capstone Terbaik · Coding Camp 2026', image: capstoneImage, alt: 'Sertifikat Best Capstone Team Coding Camp 2026 atas nama Muhammad Habib Rafi' },
      { title: 'Student Learning Achievement', meta: 'Transkrip pembelajaran Full-Stack Web Developer', image: achievementImage, alt: 'Transkrip pencapaian pembelajaran Coding Camp 2026 atas nama Muhammad Habib Rafi' },
      { title: 'English for Business Communication', meta: 'Kursus singkat · Nilai keseluruhan 76%', image: englishImage, alt: 'Sertifikat English for Business Communication atas nama Muhammad Habib Rafi' },
    ];

const labels = locale === 'en'
  ? { title: 'Verified credentials', description: 'Original certificates and learning records from the Coding Camp 2026 program.', open: 'View credential', close: 'Close credential preview', dialog: 'Credential preview' }
  : { title: 'Kredensial terverifikasi', description: 'Sertifikat asli dan rekam pembelajaran dari program Coding Camp 2026.', open: 'Lihat kredensial', close: 'Tutup pratinjau kredensial', dialog: 'Pratinjau kredensial' };
const firstCredential = credentials[0];
---

<div class="credential-gallery" data-credential-gallery>
  <div class="credential-gallery-heading">
    <div class="credential-heading-icon"><Icon name="workspace_premium" size={24} filled /></div>
    <div><h3>{labels.title}</h3><p>{labels.description}</p></div>
  </div>
  <div class="credential-grid">
    {credentials.map((credential, index) => (
      <button class="credential-card" type="button" data-credential-open={String(index)} aria-label={`${labels.open}: ${credential.title}`}>
        <span class:list={['credential-image', { portrait: credential.image.height > credential.image.width }]}>
          <Image src={credential.image} alt={credential.alt} widths={[320, 560, 800]} sizes="(max-width: 680px) 100vw, 50vw" loading="lazy" decoding="async" quality={84} />
          <span class="credential-overlay"><Icon name="zoom_in" size={25} /><span>{labels.open}</span></span>
        </span>
        <span class="credential-copy"><strong>{credential.title}</strong><small>{credential.meta}</small></span>
      </button>
    ))}
  </div>

  <dialog class="credential-dialog" data-credential-dialog aria-label={labels.dialog}>
    <div class="credential-dialog-toolbar">
      <div><strong data-dialog-title></strong><span data-dialog-meta></span></div>
      <button class="icon-button" type="button" data-credential-close aria-label={labels.close}><Icon name="close" size={22} /></button>
    </div>
    {firstCredential && <img data-dialog-image src={firstCredential.image.src} alt={firstCredential.alt} width={firstCredential.image.width} height={firstCredential.image.height} />}
  </dialog>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-credential-gallery]').forEach((gallery) => {
    const dialog = gallery.querySelector<HTMLDialogElement>('[data-credential-dialog]');
    const image = dialog?.querySelector<HTMLImageElement>('[data-dialog-image]');
    const title = dialog?.querySelector<HTMLElement>('[data-dialog-title]');
    const meta = dialog?.querySelector<HTMLElement>('[data-dialog-meta]');
    const cards = Array.from(gallery.querySelectorAll<HTMLButtonElement>('[data-credential-open]'));

    cards.forEach((card) => card.addEventListener('click', () => {
      const preview = card.querySelector<HTMLImageElement>('.credential-image img');
      const cardTitle = card.querySelector<HTMLElement>('.credential-copy strong');
      const cardMeta = card.querySelector<HTMLElement>('.credential-copy small');
      if (!dialog || !image || !preview) return;
      image.src = preview.currentSrc || preview.src;
      image.alt = preview.alt;
      image.width = preview.naturalWidth || 800;
      image.height = preview.naturalHeight || 565;
      if (title) title.textContent = cardTitle?.textContent ?? '';
      if (meta) meta.textContent = cardMeta?.textContent ?? '';
      dialog.showModal();
    }));

    dialog?.querySelector<HTMLButtonElement>('[data-credential-close]')?.addEventListener('click', () => dialog.close());
    dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  });
</script>
