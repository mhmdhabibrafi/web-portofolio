---
import type { Locale } from '@/i18n/config';
import Icon from './Icon.astro';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const isId = locale === 'id';
const initialLabel = isId ? 'Ubah ke mode terang' : 'Switch to light mode';
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  data-locale={locale}
  aria-label={initialLabel}
  title={initialLabel}
>
  <Icon name="dark_mode" size={19} class="theme-icon theme-icon-dark" />
  <Icon name="light_mode" size={19} class="theme-icon theme-icon-light" />
  <span class="sr-only" data-theme-label>{isId ? 'Mode gelap' : 'Dark mode'}</span>
</button>

<script>
  const applyTheme = (theme: 'dark' | 'light') => {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem('theme', theme);

    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      const isId = button.dataset.locale === 'id';
      const isDark = theme === 'dark';
      const label = isDark
        ? (isId ? 'Ubah ke mode terang' : 'Switch to light mode')
        : (isId ? 'Ubah ke mode gelap' : 'Switch to dark mode');
      button.setAttribute('aria-label', label);
      button.setAttribute('title', label);
      const srLabel = button.querySelector<HTMLElement>('[data-theme-label]');
      if (srLabel) {
        srLabel.textContent = isDark
          ? (isId ? 'Mode gelap aktif' : 'Dark mode active')
          : (isId ? 'Mode terang aktif' : 'Light mode active');
      }
    });
  };

  const stored = localStorage.getItem('theme');
  const initialTheme = stored === 'light' ? 'light' : 'dark';
  applyTheme(initialTheme);

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
      const next = current === 'dark' ? 'light' : 'dark';
      applyTheme(next);
    });
  });
</script>
