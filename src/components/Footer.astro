---
import { profile } from '@/data/profile';
import { socials } from '@/data/socials';
import Icon from './Icon.astro';
import BrandIcon from './BrandIcon.astro';
import { ui, type Locale } from '@/i18n/config';

interface Props { locale?: Locale }
const { locale = 'en' } = Astro.props;
const copy = ui[locale];
const prefix = locale === 'en' ? '' : '/id';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="site-container footer-grid">
    <div>
      <a class="footer-name" href={locale === 'en' ? '/' : '/id/'}>{profile.name}</a>
      <p>{profile.title}</p>
      <p class="footer-built">{copy.footer.built}</p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <a href={`${prefix}/projects/`}>{copy.navigation.projects}</a>
      <a href={`${prefix}/experience/`}>{copy.navigation.experience}</a>
      <a href={`${prefix}/contact/`}>{copy.navigation.contact}</a>
    </nav>
    <div class="footer-socials">
      <a href={socials.github} target="_blank" rel="noopener noreferrer"><BrandIcon name="github" size={17} /> GitHub <Icon name="arrow_outward" size={15} /></a>
      <a href={socials.linkedin} target="_blank" rel="noopener noreferrer"><BrandIcon name="linkedin" size={17} /> LinkedIn <Icon name="arrow_outward" size={15} /></a>
      <a href={socials.instagram} target="_blank" rel="noopener noreferrer"><BrandIcon name="instagram" size={17} /> Instagram <Icon name="arrow_outward" size={15} /></a>
      {profile.email && <a href={`mailto:${profile.email}`}><Icon name="mail" size={17} /> Email <Icon name="arrow_outward" size={15} /></a>}
    </div>
  </div>
  <div class="site-container footer-bottom">
    <span>© {year} {profile.name}</span>
    <a href="#top">{copy.footer.backToTop} <span aria-hidden="true">↑</span></a>
  </div>
</footer>
